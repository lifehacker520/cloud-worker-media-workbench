NODE_ENV=production
XHS_AUTH_REQUIRED=true
XHS_AUTH_SECRET=replace-with-a-long-random-secret
XHS_ADMIN_PASSWORD=replace-admin-password
XHS_CLIENT_PASSWORD=replace-client-password
XHS_COOKIE_SECURE=true
XHS_REFRESH_MINUTES=30
XHS_HOST_PORT=3188
# 仅用于本地界面验收；开启后读取 config/monitoring.demo.json 并跳过真实平台刷新
XHS_MONITOR_DEMO=false
XHS_DEFAULT_TENANT_ID=tenant_local
XHS_ADMIN_TENANT_ID=tenant_local
XHS_CLIENT_TENANT_ID=tenant_local
# 生产环境只允许读取这些目录中的本地素材；多个目录用逗号分隔
XHS_MEDIA_ROOTS=/srv/cloud-worker-media-workbench/uploads
# 下载中心默认写入本机 Downloads/云员工工作台/下载中心；可显式覆盖为绝对路径
XHS_DOWNLOAD_DIR=
# 可选：平台作品解析服务；桌面客户端未配置时会尝试使用已登录的平台浏览器会话
XHS_DOWNLOAD_RESOLVER_URL=
DOUYIN_DOWNLOAD_RESOLVER_URL=
# 视频号兼容视频号下载交接稿中的解析服务；不发送 Cookie 或平台登录态
WEIXIN_RESOLVER_URL=
# 可选：所有平台共用的解析服务（仅在平台专用变量为空时使用）
MEDIA_DOWNLOAD_RESOLVER_URL=
# 生产环境备份三项均需配置：加密密钥、与 data/ 独立的异地目录、保留数量或天数
XHS_BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key
XHS_BACKUP_OFFSITE_DIR=/srv/cloud-worker-media-workbench-offsite/backups
XHS_BACKUP_RETENTION_COUNT=14
# 也可以额外配置按天清理：XHS_BACKUP_RETENTION_DAYS=30
# 配置后才启用 AI 生成；密钥不要提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 没有外部模型密钥时保留本地抽取式草案；它不冒充 AI，不补写未知事实
XHS_LOCAL_DRAFT_GENERATOR=true
# 本地/演示验收时可强制只用本地模板，即使 .env 中存在 DeepSeek Key 也不发起外部请求
XHS_CONTENT_LOCAL_ONLY=false
# 可选：通用本地 ASR 命令，程序会以“命令 参数 原始素材绝对路径”调用并读取 stdout
XHS_TRANSCRIBE_COMMAND=
# 或使用内置 whisper-cli 适配器（需要先安装 whisper-cpp，并提供 GGML 模型路径）
XHS_WHISPER_COMMAND=whisper-cli
XHS_WHISPER_MODEL=
XHS_WHISPER_LANGUAGE=zh
# 可选：非 macOS 环境的 OCR 命令；macOS 默认使用 Vision 识别首个关键帧
XHS_OCR_COMMAND=
# 可选：独立媒体模型 worker；Node 客户端只通过版本化 HTTP 协议接入，不把模型权重放进 node_modules
XHS_MEDIA_WORKER_URL=
XHS_MEDIA_WORKER_ID=connector_media_worker
XHS_MEDIA_WORKER_NAME=外部媒体模型 Worker
XHS_MEDIA_WORKER_TIMEOUT_MS=15000
# 批次 Worker 并发上限；首轮建议保持 1，完成 2x3 基准后再提高
XHS_CONTENT_BATCH_MAX_CONCURRENCY=1
# Python worker 真实 wrapper 桥接（在独立 worker 环境设置，不在 Node 客户端设置）
MEDIA_WORKER_MODE=fake
MEDIA_WORKER_DATA_DIR=
MEDIA_WORKER_TTS_COMMAND=
MEDIA_WORKER_AVATAR_COMMAND=
# Apple Silicon MLX Audio wrapper；需要独立安装 mlx-audio 和已审查的本地模型权重，留空则 fail closed
MEDIA_WORKER_MLX_AUDIO_COMMAND=mlx_audio.tts.generate
MEDIA_WORKER_MLX_AUDIO_MODEL=
MEDIA_WORKER_MLX_AUDIO_MODE=clone
MEDIA_WORKER_MLX_AUDIO_VOICE=
MEDIA_WORKER_MLX_AUDIO_REF_TEXT=
MEDIA_WORKER_MLX_AUDIO_TIMEOUT_SECONDS=600
# MuseTalk 1.5 talking_head wrapper；需要独立 NVIDIA/CUDA worker、权重和许可证审查
MEDIA_WORKER_MUSETALK_ROOT=
MEDIA_WORKER_MUSETALK_COMMAND="python3 -m scripts.inference"
MEDIA_WORKER_MUSETALK_MODEL_VERSION=musetalk-1.5
MEDIA_WORKER_MUSETALK_VERSION=v15
MEDIA_WORKER_MUSETALK_UNET_MODEL_PATH=
MEDIA_WORKER_MUSETALK_UNET_CONFIG=
MEDIA_WORKER_MUSETALK_WHISPER_DIR=
MEDIA_WORKER_MUSETALK_WEIGHTS_HASH=
MEDIA_WORKER_MUSETALK_LICENSE_REF=
MEDIA_WORKER_MUSETALK_FFMPEG_PATH=
MEDIA_WORKER_MUSETALK_USE_FLOAT16=false
MEDIA_WORKER_MUSETALK_FPS=25
MEDIA_WORKER_MUSETALK_BATCH_SIZE=8
MEDIA_WORKER_MUSETALK_TIMEOUT_SECONDS=1800
# 仅 macOS 本机真实音频链路基线；不是声音克隆
MEDIA_WORKER_MACOS_SAY_VOICE=Ting-Ting
MEDIA_WORKER_TTS_MODEL=cosyvoice-3-configured
MEDIA_WORKER_AVATAR_MODEL=musetalk-configured
MEDIA_WORKER_COMMAND_TIMEOUT_SECONDS=300
