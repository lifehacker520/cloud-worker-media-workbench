NODE_ENV=production
XHS_AUTH_REQUIRED=true
XHS_AUTH_SECRET=replace-with-a-long-random-secret
XHS_ADMIN_PASSWORD=replace-admin-password
XHS_CLIENT_PASSWORD=replace-client-password
XHS_COOKIE_SECURE=true
XHS_REFRESH_MINUTES=30
XHS_HOST_PORT=3188
# 仅用于本地界面验收；开启后读取 config/monitoring.demo.json 并跳过真实平台刷新
XHS_MONITOR_DEMO=false
XHS_DEFAULT_TENANT_ID=tenant_local
XHS_ADMIN_TENANT_ID=tenant_local
XHS_CLIENT_TENANT_ID=tenant_local
# 生产环境只允许读取这些目录中的本地素材；多个目录用逗号分隔
XHS_MEDIA_ROOTS=/srv/cloud-worker-media-workbench/uploads
# 生产环境备份三项均需配置：加密密钥、与 data/ 独立的异地目录、保留数量或天数
XHS_BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-backup-key
XHS_BACKUP_OFFSITE_DIR=/srv/cloud-worker-media-workbench-offsite/backups
XHS_BACKUP_RETENTION_COUNT=14
# 也可以额外配置按天清理：XHS_BACKUP_RETENTION_DAYS=30
# 配置后才启用 AI 生成；密钥不要提交到仓库
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 没有外部模型密钥时保留本地抽取式草案；它不冒充 AI，不补写未知事实
XHS_LOCAL_DRAFT_GENERATOR=true
# 可选：通用本地 ASR 命令，程序会以“命令 参数 原始素材绝对路径”调用并读取 stdout
XHS_TRANSCRIBE_COMMAND=
# 或使用内置 whisper-cli 适配器（需要先安装 whisper-cpp，并提供 GGML 模型路径）
XHS_WHISPER_COMMAND=whisper-cli
XHS_WHISPER_MODEL=
XHS_WHISPER_LANGUAGE=zh
# 可选：非 macOS 环境的 OCR 命令；macOS 默认使用 Vision 识别首个关键帧
XHS_OCR_COMMAND=
