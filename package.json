{
  "name": "cloud-worker-media-workbench",
  "version": "0.1.13",
  "description": "云员工媒体：自媒体矩阵监控与运营桌面客户端",
  "author": "lifehacker520",
  "license": "MIT",
  "main": "electron/main.mjs",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env server.mjs",
    "desktop": "electron .",
    "eval:deepseek": "node tools/deepseek-quality-eval.mjs",
    "backup:workbench": "node tools/workbench-backup.mjs",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "check": "node --check server.mjs && node --check src/auth.mjs && node --check src/content-workflow.mjs && node --check src/workbench-store.mjs && node --check src/workbench-backup.mjs && node --check src/media-pipeline.mjs && node --check src/ai-provider.mjs && node --check src/quality-evaluator.mjs && node --check tools/deepseek-quality-eval.mjs && node --check tools/workbench-backup.mjs && node --check src/xhs-parser.mjs && node --check src/douyin-parser.mjs && node --check src/channels-parser.mjs && node --check src/platforms.mjs && node --check public/app.js && node --check public/content-workspace.js && node --check public/publish-workspace.js && node --check public/workspace-admin.js && node --check electron/main.mjs && node --check electron/platform-browser.mjs && node --check electron/preload.mjs",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lifehacker520/cloud-worker-media-workbench.git"
  },
  "homepage": "https://github.com/lifehacker520/cloud-worker-media-workbench#readme",
  "build": {
    "appId": "com.aios.xhscontentmonitor",
    "productName": "云员工媒体",
    "artifactName": "cloud-worker-media-workbench-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "asarUnpack": [
      "tools/**/*"
    ],
    "extraResources": [
      {
        "from": "tools",
        "to": "tools"
      }
    ],
    "files": [
      "electron/**/*",
      "public/**/*",
      "src/**/*",
      "tools/**/*",
      "config/**/*",
      "server.mjs",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.business"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lifehacker520",
        "repo": "cloud-worker-media-workbench"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  }
}
